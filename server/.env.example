# Server
NODE_ENV=development
PORT=5050

# MongoDB connection string. Not needed for `npm run demo` (in-memory database).
# For MongoDB Atlas, use the SRV URI and include the application database name:
# MONGO_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster-host>/wildplay
MONGO_URI=mongodb://127.0.0.1:27017/wildplay

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API with cookies
CLIENT_ORIGIN=http://localhost:5173
